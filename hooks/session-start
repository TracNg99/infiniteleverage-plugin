#!/usr/bin/env bash
# SessionStart hook for Infinite Leverage plugin.
# Stage 1: detect if 8-agent team is initialized.
# Stage 2: check if template version is current.
# Stage 3: silent pass (routing context is in CLAUDE.md, not re-injected here).

set -euo pipefail

# --- Config ---
IL_TEMPLATE_REPO_URL="https://raw.githubusercontent.com/talentedgeai/infiniteleverage-8-agents-template/main/VERSION"
IL_AGENTS_DIR="${HOME}/.claude/agents"
IL_VERSION_FILE="${HOME}/.claude/.infiniteleverage-version"
EXPECTED_AGENTS=("designer.md" "developer.md" "devops.md" "email-marketer.md" "product-manager.md" "qa.md" "web-publisher.md" "writer.md")

# --- Helpers ---
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

emit_context() {
  local content="$1"
  local escaped
  escaped="$(escape_for_json "$content")"
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
  else
    printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
  fi
}

# --- Stage 1: Initialization check ---
initialized=true
for agent in "${EXPECTED_AGENTS[@]}"; do
  if [[ ! -f "${IL_AGENTS_DIR}/${agent}" ]]; then
    initialized=false
    break
  fi
done

if [[ "$initialized" == "false" ]]; then
  emit_context "# Infinite Leverage Plugin Active

Your 8-agent team is not configured yet.
Run **/infiniteleverage-init** to set up your team (takes ~5 minutes)."
  exit 0
fi

# --- Stage 2: Version check (silent on network failure) ---
advisory=""
local_version=""
if [[ -f "$IL_VERSION_FILE" ]]; then
  local_version="$(tr -d '[:space:]' < "$IL_VERSION_FILE")"
fi

if [[ -n "$local_version" ]]; then
  remote_version=""
  remote_version="$(curl --silent --max-time 3 "$IL_TEMPLATE_REPO_URL" 2>/dev/null | tr -d '[:space:]')" || true

  if [[ "$remote_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$remote_version" != "$local_version" ]]; then
    advisory="# Infinite Leverage Update Available

Template **${remote_version}** is available (you have **${local_version}**).
Run **/infiniteleverage-patch** to apply updates."
  fi
fi

if [[ -n "$advisory" ]]; then
  emit_context "$advisory"
fi

exit 0
