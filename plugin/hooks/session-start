#!/usr/bin/env bash
# SessionStart hook for Infinite Leverage plugin.
# Stage 1: detect if 8-agent team is initialized.
# Stage 2: auto-update agents and skills from template repo when a newer version exists.
# Stage 3: silent pass (routing context is in CLAUDE.md, not re-injected here).
# Stage 4: inject compact token-usage briefing via usage-context.py.

set -euo pipefail

# --- Config ---
IL_TEMPLATE_REPO="https://github.com/talentedgeai/infiniteleverage-8-agents-template.git"
IL_TEMPLATE_VERSION_URL="https://raw.githubusercontent.com/talentedgeai/infiniteleverage-8-agents-template/main/VERSION"
IL_AGENTS_DIR="${HOME}/.claude/agents"
IL_SKILLS_DIR="${HOME}/.claude/skills"
IL_VERSION_FILE="${HOME}/.claude/.infiniteleverage-version"
EXPECTED_AGENTS=("designer.md" "developer.md" "devops.md" "email-marketer.md" "product-manager.md" "qa.md" "web-publisher.md" "writer.md")

# --- Helpers ---
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

emit_context() {
  local content="$1"
  local escaped
  escaped="$(escape_for_json "$content")"
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
  else
    printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
  fi
}

# --- Stage 1: Initialization check ---
initialized=true
for agent in "${EXPECTED_AGENTS[@]}"; do
  if [[ ! -f "${IL_AGENTS_DIR}/${agent}" ]]; then
    initialized=false
    break
  fi
done

if [[ "$initialized" == "false" ]]; then
  emit_context "# Infinite Leverage Plugin Active

Your 8-agent team is not configured yet.
Run **/infiniteleverage-init** to set up your team (takes ~5 minutes)."
  exit 0
fi

# --- Stage 2: Auto-update agents and skills when a newer version exists ---
local_version=""
if [[ -f "$IL_VERSION_FILE" ]]; then
  local_version="$(tr -d '[:space:]' < "$IL_VERSION_FILE")"
fi

if [[ -n "$local_version" ]]; then
  remote_version=""
  remote_version="$(curl --silent --max-time 5 "$IL_TEMPLATE_VERSION_URL" 2>/dev/null | tr -d '[:space:]')" || true

  if [[ "$remote_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$remote_version" != "$local_version" ]]; then
    # Attempt auto-update via git clone
    tmp_dir="$(mktemp -d)"
    update_ok=false

    if git clone --depth 1 --quiet "$IL_TEMPLATE_REPO" "$tmp_dir" 2>/dev/null; then
      # Update agents (all 8)
      cp "$tmp_dir/.claude/agents/"*.md "${IL_AGENTS_DIR}/" 2>/dev/null && update_ok=true

      # Update skills that are already installed locally (never install new ones)
      if [[ -d "$tmp_dir/.claude/skills" && -d "$IL_SKILLS_DIR" ]]; then
        for skill_src in "$tmp_dir/.claude/skills"/*/; do
          skill_name="$(basename "$skill_src")"
          skill_dest="${IL_SKILLS_DIR}/${skill_name}"
          if [[ -d "$skill_dest" ]]; then
            cp -r "$skill_src/." "$skill_dest/" 2>/dev/null || true
          fi
        done
      fi

      # Stamp new version
      echo "$remote_version" > "$IL_VERSION_FILE"

      emit_context "# Infinite Leverage Auto-Updated ✓

Agents and skills updated **${local_version}** → **${remote_version}** automatically.
All 8 agents now reflect the latest definitions from the canonical repo."
    else
      # Clone failed — fall back to advisory
      emit_context "# Infinite Leverage Update Available

Template **${remote_version}** is available (you have **${local_version}**).
Run **/infiniteleverage-patch** to apply updates manually."
    fi

    rm -rf "$tmp_dir" 2>/dev/null || true
  fi
fi

# --- Stage 4: Usage awareness (silent on failure) ---
USAGE_SCRIPT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}/hooks/usage-context.py"
if [[ -f "$USAGE_SCRIPT" ]]; then
  usage_line="$(python3 "$USAGE_SCRIPT" 2>/dev/null)" || true
  if [[ -n "$usage_line" ]]; then
    emit_context "$usage_line"
  fi
fi

exit 0
